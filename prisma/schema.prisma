generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----- مدل ادمین / کارمند -----
model Admin {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String // هش شده
  email     String?   @unique
  role      AdminRole @default(EMPLOYEE) // نقش: کارمند یا ادمین اصلی
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  resetTokens   PasswordResetToken[]
  workReports   WorkReport[] // گزارشات کاری کارمند
  assignedUsers User[]               @relation("AdminUsers") // کلاینت‌هایی که زیر نظر این کارمند هستند
}

enum AdminRole {
  EMPLOYEE // کارمند معمولی
  ADMIN // ادمین اصلی
}

// ----- مدل User (کلاینت) -----
model User {
  id              Int        @id @default(autoincrement())
  name            String
  fatherName      String
  code            String     @unique
  phone           String?
  idCardImage     String?
  profileImage    String?
  immigrationCase String?
  slug            String     @unique @default("temp-slug")
  status          UserStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workReports WorkReport[] // گزارشات مربوط به این کلاینت (اختیاری)

  assignedAdminId String?
  assignedAdmin   Admin?  @relation("AdminUsers", fields: [assignedAdminId], references: [id])

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// ----- مدل گزارش کار کارمند -----
model WorkReport {
  id         String       @id @default(uuid())
  adminId    String // Admin واقعی
  admin      Admin        @relation(fields: [adminId], references: [id])
  employeeId String? // کارمندی که گزارش را ثبت کرده (اختیاری)
  userId     Int? // اگر گزارش مربوط به یک کلاینت خاص باشد
  user       User?        @relation(fields: [userId], references: [id])
  title      String // عنوان گزارش
  content    String // توضیحات کامل
  status     ReportStatus @default(PENDING) // وضعیت گزارش
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("work_reports")
}

enum ReportStatus {
  PENDING // ثبت شده ولی بررسی نشده
  REVIEWED // بررسی شده
  COMPLETED // انجام شده
}

// ----- مدل Reservation -----
model Reservation {
  id        String            @id @default(uuid())
  fullName  String
  email     String?
  phone     String
  visaType  String
  status    ReservationStatus @default(PENDING)
  createAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum ReservationStatus {
  PENDING // در انتظار بررسی
  APPROVED // تایید شده
  REJECTED // رد شده
}

// ----- مدل کشور -----
model Country {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  countryCode String // مثل "nl" یا "de"
  flagUrl     String?
  coverImage  String?
  // رابطه Many-to-Many با ویزا
  visaTypes   VisaType[] @relation("CountryVisaTypes")
  // محتواهای عمومی کشور (visaTypes مرتبط نیستند)
  contents    Content[]

  visaCovers CountryVisaCover[]
}

// ----- مدل ویزا -----
model VisaType {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  // رابطه Many-to-Many با کشور
  countries    Country[] @relation("CountryVisaTypes")
  // رابطه Many-to-Many با محتوا
  contents     Content[] @relation("ContentVisaTypes")
  showInNavbar Boolean   @default(true)
  showInFooter Boolean   @default(false)

  countryCovers CountryVisaCover[]
}

// ----- مدل محتوا -----
model Content {
  id        String          @id @default(uuid())
  title     String
  body      String
  section   ContentSection?
  imageUrl  String?
  order     Int?
  // هر محتوا به یک کشور تعلق دارد
  countryId String
  country   Country         @relation(fields: [countryId], references: [id])
  // رابطه Many-to-Many با ویزا (اختیاری)
  visaTypes VisaType[]      @relation("ContentVisaTypes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----- enum برای بخش‌های محتوا -----
enum ContentSection {
  Introduction
  Benefits
  Requirements
  Fees
  VisaType
  Process
  Contact
  Renewal
  Opportunities
  Tips
  FAQ
  Conclusion
  Documents
  Interview
}

// مدل جدید برای کاور اختصاصی هر کشور و ویزا
model CountryVisaCover {
  id         String   @id @default(uuid())
  country    Country  @relation(fields: [countryId], references: [id])
  countryId  String
  visaType   VisaType @relation(fields: [visaTypeId], references: [id])
  visaTypeId String

  coverImage String?

  @@unique([countryId, visaTypeId]) // جلوگیری از تکرار یک کشور-ویزای مشابه
}

// ----- مدل contactMessage -----
model contactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// ----- مدل PasswordResetToken -----
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String // کلید خارجی
  admin     Admin    @relation(fields: [adminId], references: [id]) // رابطه
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ----- مدل ImmigrationEvaluation -----
model ImmigrationEvaluation {
  id           Int            @id @default(autoincrement())
  fullName     String
  age          Int
  education    EducationLevel
  experience   Int
  englishLevel EnglishLevel
  country      String
  phone        String
  email        String         @unique
  createdAt    DateTime       @default(now())
}

enum EducationLevel {
  highschool
  bachelor
  master
  phd
}

enum EnglishLevel {
  beginner
  intermediate
  advanced
}
